const http = require('http');
const url = require('url');
const querystring = require('querystring');
const configManager = require('./configManager.js');
const sessionManager = require('./sessionManager.js');
const owner = require('./owner.js');
const QRCode = require('qrcode');

class WebServer {
    constructor(botState) {
        this.botState = botState;
        this.port = process.env.PORT || 3000;
    }
    
    async generateQRImage(qrText) {
        try {
            return await QRCode.toDataURL(qrText);
        } catch (err) {
            return null;
        }
    }
    
    getWebPage(queryParams = {}) {
        const config = configManager.getConfig();
        const sessionStatus = sessionManager.getSessionStatus();
        
        let formMessage = '';
        if (queryParams.action === 'update') {
            if (configManager.updateFromWeb(queryParams)) {
                formMessage = '<div class="success">✅ Settings saved!</div>';
            }
        }
        
        let status, message, qrDisplay;
        const { currentQR, qrImageData, isConnected } = this.botState;
        
        if (isConnected) {
            status = '✅ Connected';
            message = 'Bot is running';
            qrDisplay = '';
        } else if (sessionStatus.activated && !currentQR) {
            status = '🔄 Reconnecting';
            message = 'Session Activated';
            qrDisplay = '';
        } else if (currentQR) {
            status = '📱 Scan QR';
            message = 'Scan with WhatsApp';
            qrDisplay = `
            <div class="qr-box">
                <h3><i class="fas fa-qrcode"></i> QR Code</h3>
                ${qrImageData ? `<img src="${qrImageData}" class="qr-img">` : ''}
                <p>Scan with WhatsApp > Linked Devices</p>
            </div>`;
        } else {
            status = '⏳ Starting';
            message = 'Initializing bot...';
            qrDisplay = '';
        }
        
        return `
        <!DOCTYPE html>
        <html>
        <head>
            <title>Muzammil MD Bot</title>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <style>
                body { font-family: Arial; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #333; margin: 0; padding: 20px; min-height: 100vh; display: flex; justify-content: center; align-items: center; }
                .container { background: white; border-radius: 15px; padding: 30px; max-width: 500px; width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
                .header { text-align: center; margin-bottom: 20px; }
                .header h1 { color: #333; margin: 0; display: flex; align-items: center; justify-content: center; gap: 10px; }
                .status { background: #f8f9ff; border-radius: 10px; padding: 20px; text-align: center; margin-bottom: 20px; border-left: 5px solid #667eea; }
                .status-icon { font-size: 40px; margin-bottom: 10px; }
                .status-text { font-size: 20px; font-weight: bold; margin-bottom: 5px; }
                .status-msg { color: #666; }
                .qr-box { background: #f0fff4; border-radius: 10px; padding: 20px; margin: 20px 0; border: 2px solid #25D366; text-align: center; }
                .qr-img { width: 200px; height: 200px; margin: 10px auto; border-radius: 10px; }
                .config-form { margin-top: 20px; }
                .form-group { margin-bottom: 15px; }
                label { display: block; margin-bottom: 5px; font-weight: bold; }
                input[type="text"] { width: 100%; padding: 10px; border: 2px solid #ddd; border-radius: 5px; font-size: 16px; }
                .radio-group { display: flex; gap: 10px; }
                .radio-option { flex: 1; }
                .radio-option input { display: none; }
                .radio-label { display: block; padding: 10px; border: 2px solid #ddd; border-radius: 5px; text-align: center; cursor: pointer; }
                .radio-option input:checked + .radio-label { background: #667eea; color: white; border-color: #667eea; }
                .btn { width: 100%; padding: 12px; background: #667eea; color: white; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 10px; }
                .success { background: #d4edda; color: #155724; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center; }
                .footer { margin-top: 20px; padding-top: 15px; border-top: 1px solid #eee; text-align: center; color: #666; font-size: 14px; }
            </style>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        </head>
        <body>
            <div class="container">
                <div class="header">
                    <h1><i class="fab fa-whatsapp"></i> Muzammil MD Bot</h1>
                </div>
                
                ${formMessage}
                
                <div class="status">
                    <div class="status-icon">
                        ${isConnected ? '✅' : currentQR ? '📱' : '🔄'}
                    </div>
                    <div class="status-text">${status}</div>
                    <div class="status-msg">${message}</div>
                </div>
                
                ${qrDisplay}
                
                <form method="GET" action="/" class="config-form">
                    <input type="hidden" name="action" value="update">
                    
                    <div class="form-group">
                        <label><i class="fas fa-hashtag"></i> Command Prefix</label>
                        <input type="text" name="prefix" value="${config.bot.prefix}" placeholder=". ! #">
                    </div>
                    
                    <div class="form-group">
                        <label><i class="fas fa-users"></i> Bot Mode</label>
                        <div class="radio-group">
                            <div class="radio-option">
                                <input type="radio" id="public" name="mode" value="public" 
                                       ${config.bot.mode === 'public' ? 'checked' : ''}>
                                <label for="public" class="radio-label">Public</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="private" name="mode" value="private" 
                                       ${config.bot.mode === 'private' ? 'checked' : ''}>
                                <label for="private" class="radio-label">Private</label>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn">
                        <i class="fas fa-save"></i> Save Settings
                    </button>
                </form>
                
                <div class="footer">
                    <p><i class="fas fa-user"></i> Owner: ${owner.name}</p>
                    <p>Session: ${sessionStatus.message}</p>
                </div>
            </div>
            
            <script>
                if(${currentQR ? 'true' : 'false'}) {
                    setTimeout(() => location.reload(), 30000);
                }
            </script>
        </body>
        </html>`;
    }
    
    start() {
        const server = http.createServer(async (req, res) => {
            const parsedUrl = url.parse(req.url);
            const queryParams = querystring.parse(parsedUrl.query);
            
            res.writeHead(200, { 'Content-Type': 'text/html' });
            res.end(this.getWebPage(queryParams));
        });
        
        server.listen(this.port, () => {
            console.log(`🌐 Web: http://localhost:${this.port}`);
        });
    }
}

module.exports = WebServer;
