const { default: makeWASocket, useMultiFileAuthState } = require('@whiskeysockets/baileys');
const config = require('./config.js');
const owner = require('./owner.js');
const plugins = require('./loader.js');
const express = require('express');
const http = require('http');
const socketIO = require('socket.io');
const path = require('path');

// Express app
const app = express();
const server = http.createServer(app);
const io = socketIO(server);

// Serve static files
app.use(express.static(path.join(__dirname, 'public')));

// Routes
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.get('/status', (req, res) => {
    res.json({
        status: 'running',
        bot: config.bot.name,
        owner: owner.personal.name,
        mode: config.bot.mode
    });
});

let sock = null;
let currentQR = null;

async function startBot() {
    console.log(`🚀 ${config.bot.name} Starting...`);
    
    const { state, saveCreds } = await useMultiFileAuthState(config.session.savePath);
    
    sock = makeWASocket({
        auth: state,
        printQRInTerminal: false, // Disable terminal QR
        browser: ['Ubuntu', 'Chrome', '20.0.04']
    });

    sock.ev.on('connection.update', async (update) => {
        const { connection, lastDisconnect, qr } = update;
        
        if (qr) {
            // Send QR to web interface
            currentQR = qr;
            io.emit('qr', qr);
            io.emit('sessionStatus', 'New session - Please scan QR');
        }
        
        if (connection === 'close') {
            io.emit('sessionStatus', 'Disconnected - Reconnecting...');
            setTimeout(() => startBot(), 5000);
        } else if (connection === 'open') {
            console.log('✅ Connected!');
            io.emit('connected', {
                botName: config.bot.name,
                mode: config.bot.mode,
                prefix: config.bot.prefix
            });
            io.emit('sessionStatus', 'Session Active - Already Activated');
            
            // Send welcome message to owner
            const welcomeMsg = `✅ ${config.bot.name} is now active!\nMode: ${config.bot.mode}\nPrefix: ${config.bot.prefix}\nHeroku App: ${process.env.HEROKU_APP_NAME || 'Active'}`;
            sock.sendMessage(owner.personal.number + '@s.whatsapp.net', { text: welcomeMsg });
        }
    });

    sock.ev.on('creds.update', saveCreds);
    
    // Message handling
    sock.ev.on('messages.upsert', async ({ messages }) => {
        const msg = messages[0];
        if (!msg.message || msg.key.fromMe) return;
        
        const jid = msg.key.remoteJid;
        const text = msg.message.conversation || 
                    msg.message.extendedTextMessage?.text || '';
        
        if (text.startsWith(config.bot.prefix)) {
            const command = text.slice(config.bot.prefix.length).split(' ')[0];
            if (plugins[command]) {
                await plugins[command].handler(msg, sock, text.split(' ').slice(1));
            }
        }
    });
}

// Socket connection
io.on('connection', (socket) => {
    console.log('🌐 Web client connected');
    
    // Send current status
    if (currentQR) {
        socket.emit('qr', currentQR);
        socket.emit('sessionStatus', 'Waiting for QR scan...');
    } else {
        socket.emit('sessionStatus', 'Session Active - Already Activated');
    }
});

// Start server
const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
    console.log(`🌐 Web server: http://localhost:${PORT}`);
    startBot();
});
